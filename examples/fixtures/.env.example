    """
# A minimal routing config
routes:
  - id: primary-chat
    type: standard
    provider: openai/gpt-4o
  - id: auxiliary-search
    type: auxiliary
    provider: openai/gpt-4o-mini
  - id: code-assistant
    type: standard
    provider: anthropic/claude-3-5-sonnet
  - id: image-gen
    type: auxiliary
    provider: openai/dall-e-3
""",
    """
# Routing policy that blocks premium in auxiliary
routes:
  - id: primary-chat
    type: standard
    allowed_providers:
      - openai
      - anthropic
  - id: auxiliary-search
    type: auxiliary
    blocked_providers:
      - openai
      - anthropic
      - cohere
      - google
      - azure
  - id: code-assistant
    type: standard
    allowed_providers:
      - anthropic
  - id: image-gen
    type: auxiliary
    blocked_providers:
      - openai
      - google
""",
    """
[
  {
    "id": "notify-job",
    "enabled": true,
    "script": "/scripts/notify.py",
    "last_run": "2020-01-01T00:00:00Z",
    "outputs": ["output/report.json"]
  },
  {
    "id": "sync-job",
    "enabled": true,
    "script": "/scripts/sync.py"
